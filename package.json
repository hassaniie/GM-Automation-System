{
  "name": "mg-ga-andon",
  "private": true,
  "description": "MG GA Andon system and digital twin (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mg/web dev",
    "build": "pnpm --filter @mg/web build",
    "build:demo": "pnpm --filter @mg/web build:demo",
    "preview": "pnpm --filter @mg/web preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "dev:edge": "pnpm --filter @mg/edge dev",
    "start:edge": "pnpm --filter @mg/web build:edge && pnpm --filter @mg/edge start",
    "dev:all": "pnpm --parallel --filter @mg/edge --filter @mg/web run dev:remote"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "^5.1.0"
  }
}
