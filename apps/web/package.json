{
  "name": "@mg/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "build:edge": "vite build --mode edge",
    "dev:remote": "vite --mode edge",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:layout": "vite build --mode demo && playwright test e2e/layout.spec.ts --trace off",
    "test:ui": "vite build --mode demo && storybook build -o storybook-static --quiet && playwright test --trace off",
    "test:visual": "playwright test e2e/visual.spec.ts --trace off"
  },
  "dependencies": {
    "@mg/contracts": "workspace:*",
    "@mg/core": "workspace:*",
    "@mg/engine": "workspace:*",
    "@mg/reports": "workspace:*",
    "@mg/scene": "workspace:*",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@mg/sim": "workspace:*",
    "@mg/sync": "workspace:*",
    "exceljs": "4.4.0",
    "htm": "3.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.6.3",
    "storybook": "10.6.3"
  }
}
