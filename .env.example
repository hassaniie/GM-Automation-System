# Edge server settings (copy to .env). See README → "Live screens with the edge server".
DATABASE_URL=postgres://mg:mg@localhost:5432/mg_andon
PORT=8787
# Demo mode seeds the five demo accounts on first run and allows the demo role switch.
DEMO=1
# Without DEMO, the first administrator is created from these on first run:
# ADMIN_EMP_ID=MG-1001
# ADMIN_PASSWORD=change-me-now
# Keep history this many days (to be confirmed with MG JW).
RETENTION_DAYS=730
# Plant: simulation (default), shadow (devices logged, simulator on screens) or live (devices drive the plant)
PLANT_MODE=simulation
# DEVICES_FILE=config/devices.json
PLANT_TZ=Asia/Karachi
# Simulation
SIM_SEED=11
SIM_SPEED=15
# Single sign-on (OpenID Connect) — off unless all four are set
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://andon.example.local/api/auth/oidc/callback
